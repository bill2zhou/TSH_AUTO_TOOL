<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
    </startup>
    <appSettings>
        <!-- 站点 / 产线信息 -->
        <add key="SAPPLANT" value="CD10"/>
        <add key="LINENAME" value="CD2SMTH"/>
        <add key="GROUPNAME" value="ATE"/>
        <add key="CUSTCODE" value="A31"/>
        <add key="PROCESS" value="SMT"/>
        <add key="MOUNTSIDE" value="C"/>
        <add key="EQUIPTYPE" value="ATE"/>
        <add key="OPEUSER" value="AUTO"/>
        <add key="FACTORYSN" value="1101193011"/>
        <!-- 路径 -->
        <add key="LOGFILEPATH" value="D:\DESK\"/>
        <add key="INPUTPATH" value="D:\TESTLOG\"/>
        <add key="OUTPUTPATH" value="D:\TEST\"/>
        <!-- TAP 的 State_TSH_*.csv / Results_*.csv 所在目录，不存在时程序只提示不崩溃 -->
        <add key="CSVPATH" value="C:\ProgramData\Teradyne\TSDevPro\TAP\TAP_Controller\"/>
        <!-- TAP 版本文件，不存在时程序只提示并等待，出现后自动继续处理 -->
        <add key="VERSIONFILE" value="C:\Teradyne\TSDevPro\TestStationfixedsprs.txt"/>
        <!-- 上传服务器：1 上传，其它不上传 -->
        <add key="SENDMSG2SERVER" value="1"/>
        <!-- DELL 日志：0 不记录，1 只记一条，ALL 全部记录 -->
        <add key="DELLLOG" value="ALL"/>
        <!-- SKU 文件处理：1 存在 <SKU>.txt 时按文件内容补写开短路项目，0 关闭该处理 -->
        <add key="SKU_FILE_PROC" value="1"/>
        <!-- FMDI 查询服务（原 FMDI.ini） -->
        <add key="FMDI_URL" value="http://192.188.0.13:9092/FMDI/SMT/FTSTDCHECK.ashx"/>
        <add key="FMDI_SITE" value="CD10"/>
        <add key="FMDI_LINE" value="CD2SMTA"/>
        <!-- 1 暂停处理（打开设置窗口时），0 正常运行 -->
        <add key="APPSTOP" value="0"/>
    </appSettings>
    <system.serviceModel>
        <bindings>
            <basicHttpBinding>
                <binding name="WSHttpBinding_IServiceLibrary"/>
            </basicHttpBinding>
        </bindings>
        <client>
            <endpoint address="http://192.188.2.222:8000/FactorySvr" binding="basicHttpBinding" bindingConfiguration="WSHttpBinding_IServiceLibrary" contract="ServiceReference1.IServiceLibrary" name="WSHttpBinding_IServiceLibrary">
                <identity>
                    <dns value="localhost"/>
                </identity>
            </endpoint>
        </client>
    </system.serviceModel>
</configuration>
